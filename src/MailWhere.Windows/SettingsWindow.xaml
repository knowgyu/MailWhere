<Window x:Class="MailWhere.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Height="620" Width="760" MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource MwBrush.Page}" Icon="Assets/app-icon.ico">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource MwButton.Base}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MwBrush.Text}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,12,12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,4,12,12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,12,12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource MwPanelBorder}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MwBrush.TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="18" Background="{StaticResource MwBrush.Surface}" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource MwBrush.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="설정" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MwBrush.TextStrong}"/>
                <TextBlock Text="필요한 옵션만 탭으로 정리합니다." Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MwBrush.TextMuted}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="18" Background="{StaticResource MwBrush.Surface}" Padding="12" BorderBrush="{StaticResource MwBrush.Border}" BorderThickness="1">
            <TabControl>
                <TabItem Header="기본">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="실행" FontSize="16" FontWeight="Bold"/>
                                    <CheckBox x:Name="StartupToggle" Content="Windows 시작 시 트레이에서 실행" Margin="0,10,0,8"/>
                                    <CheckBox x:Name="AutoWatcherToggle" Content="새 메일 자동 확인" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="최근 메일 범위" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="RecentRangeBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="자동 확인 간격" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="AutomaticScanIntervalBox">
                                                <ComboBoxItem Tag="1" Content="1분마다"/>
                                                <ComboBoxItem Tag="10" Content="10분마다"/>
                                                <ComboBoxItem Tag="15" Content="15분마다"/>
                                                <ComboBoxItem Tag="30" Content="30분마다"/>
                                                <ComboBoxItem Tag="60" Content="1시간마다"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="알림">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="업무 알림" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="마감이 가까운 업무만 조용히 알려줍니다. 아침 업무 보드는 정해진 시각에 자동으로 열립니다." Margin="0,6,0,10"/>
                                    <TextBlock Text="마감 알림" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="ReminderModeBox"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="AI 분석">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="AI 연결" FontSize="16" FontWeight="Bold"/>
                                    <CheckBox x:Name="LlmEnabledToggle" Content="AI 분석 사용" Margin="0,10,0,10" Click="LlmEnabled_Click"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="방식" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="LlmProviderBox">
                                                <ComboBoxItem Tag="OllamaNative" Content="Ollama 로컬"/>
                                                <ComboBoxItem Tag="OpenAiChatCompletions" Content="OpenAI 호환 · Chat Completions"/>
                                                <ComboBoxItem Tag="OpenAiResponses" Content="OpenAI 호환 · Responses"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="주소" FontWeight="SemiBold"/>
                                            <Grid>
                                                <TextBox x:Name="LlmEndpointText" ToolTip="예: http://localhost:11434 또는 https://api.openai.com/v1"/>
                                                <TextBlock Text="예: http://localhost:11434" Foreground="{StaticResource MwBrush.TextMuted}" Margin="10,12,0,0" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=LlmEndpointText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="모델" FontWeight="SemiBold"/>
                                            <Grid>
                                                <ComboBox x:Name="LlmModelBox" IsEditable="True"/>
                                                <TextBlock Text="모델을 불러오거나 직접 입력" Foreground="{StaticResource MwBrush.TextMuted}" Margin="10,12,0,0" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=LlmModelBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                        <Button x:Name="LoadModelsButton" Grid.Column="1" Click="LoadModels_Click" VerticalAlignment="Center">모델 불러오기</Button>
                                    </Grid>

                                    <TextBlock Text="인증" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="LlmAuthModeBox" SelectionChanged="AuthMode_SelectionChanged">
                                        <ComboBoxItem Tag="None" Content="인증 없음"/>
                                        <ComboBoxItem Tag="Direct" Content="API 키 입력"/>
                                        <ComboBoxItem Tag="Environment" Content="저장된 환경 변수 사용"/>
                                    </ComboBox>
                                    <TextBlock Text="API 키" FontWeight="SemiBold"/>
                                    <PasswordBox x:Name="LlmApiKeyBox" ToolTip="개인 PC에 암호화 없이 저장됩니다. 가능하면 환경 변수 사용을 권장합니다."/>
                                    <TextBlock Text="환경 변수 이름" FontWeight="SemiBold"/>
                                    <TextBox x:Name="LlmApiKeyEnvText" ToolTip="예: OPENAI_API_KEY"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="응답 대기" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="LlmTimeoutBox">
                                                <ComboBoxItem Tag="30" Content="30초"/>
                                                <ComboBoxItem Tag="60" Content="1분"/>
                                                <ComboBoxItem Tag="90" Content="1분 30초"/>
                                                <ComboBoxItem Tag="180" Content="3분"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="AI 실패 시" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="LlmFallbackPolicyBox">
                                                <ComboBoxItem Tag="LlmOnly" Content="확인 필요에 보관"/>
                                                <ComboBoxItem Tag="LlmThenRules" Content="규칙 기반 보조 허용"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="LlmFailureFallbackPromptToggle"
                                              Content="AI 실패 시 규칙 fallback 제안 알림 표시"
                                              ToolTip="꺼두면 AI 실패는 선택한 'AI 실패 시' 정책대로 처리하며 팝업을 띄우지 않습니다."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TestConnectionButton" Click="TestConnection_Click" Style="{StaticResource MwButton.Primary}">연결 테스트</Button>
                                        <TextBlock x:Name="LlmStatusText" Text="연결 테스트 전입니다." VerticalAlignment="Center" Foreground="{StaticResource MwBrush.TextMuted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="개발자 도구">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="로컬 화면 테스트" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="메일을 읽지 않고 보드/알림 화면만 바로 확인합니다."/>
                                    <WrapPanel>
                                        <Button Click="OpenToday_Click" Style="{StaticResource MwButton.Primary}">오늘 열기</Button>
                                        <Button Click="OpenWeek_Click">이번 주 열기</Button>
                                        <Button Click="OpenAll_Click">전체 열기</Button>
                                        <Button Click="OpenNoDue_Click">날짜 없음 열기</Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="샘플 데이터와 알림" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="개발/테스트용으로만 로컬 데이터를 추가합니다."/>
                                    <WrapPanel>
                                        <Button Click="Toast_Click" Style="{StaticResource MwButton.Primary}">알림 보내기</Button>
                                        <Button Click="SampleTasks_Click">샘플 업무 추가</Button>
                                        <Button Click="SampleReview_Click">샘플 확인 필요 추가</Button>
                                        <Button Click="ResetTodayMarker_Click">오늘 표시 기록 초기화</Button>
                                        <Button Click="ResetLocalData_Click" Style="{StaticResource MwButton.Danger}">로컬 업무 데이터 삭제</Button>
                                    </WrapPanel>
                                    <TextBlock x:Name="DeveloperStatusText" Style="{StaticResource HintText}" Text="테스트 버튼은 로컬 데이터와 알림 동작 확인용입니다." Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="2" CornerRadius="16" Background="{StaticResource MwBrush.Surface}" Padding="10" Margin="0,10,0,0" BorderBrush="{StaticResource MwBrush.Border}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsCancel="True" Padding="14,7">취소(Esc)</Button>
                <Button IsDefault="True" Click="Save_Click" Style="{StaticResource MwButton.Primary}" Padding="14,7" Margin="0">저장(Enter)</Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
