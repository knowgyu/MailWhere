<Window x:Class="MailWhere.Windows.MailSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="메일 검색" Height="620" Width="980" MinHeight="460" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="{StaticResource MwBrush.Page}" Icon="Assets/app-icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource MwButton.Base}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MwBrush.Text}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MwCardListBoxItem}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{StaticResource MwBrush.SurfaceMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MwBrush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="18" Background="{StaticResource MwBrush.Surface}" Padding="12,10" Margin="0,0,0,10" BorderBrush="{StaticResource MwBrush.Border}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Click="Close_Click" Style="{StaticResource MwButton.Ghost}" Margin="0">_닫기(Esc)</Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="메일 검색" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MwBrush.TextStrong}"/>
                    <TextBlock x:Name="StatusText" Text="로컬 메일 인덱스에서만 검색합니다." Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource MwBrush.TextMuted}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="18" Background="{StaticResource MwBrush.Surface}" Padding="12" Margin="0,0,0,10" BorderBrush="{StaticResource MwBrush.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryBox" Grid.Column="0" MinHeight="34" VerticalContentAlignment="Center" Padding="10,5" Margin="0,0,8,0" KeyDown="QueryBox_KeyDown" AutomationProperties.Name="메일 검색어" ToolTip="제목, 보낸 사람, 본문에서 찾을 검색어"/>
                <ComboBox x:Name="FolderFilter" Grid.Column="1" MinHeight="34" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="메일 폴더" ToolTip="검색할 메일 폴더">
                    <ComboBoxItem Content="전체"/>
                    <ComboBoxItem Content="받은 메일"/>
                    <ComboBoxItem Content="보낸 메일"/>
                </ComboBox>
                <Button x:Name="SearchButton" Grid.Column="2" Click="Search_Click" Style="{StaticResource MwButton.Primary}" MinWidth="86" Margin="0">_검색</Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" CornerRadius="18" Background="{StaticResource MwBrush.Surface}" Padding="10" BorderBrush="{StaticResource MwBrush.Border}" BorderThickness="1">
            <Grid>
                <ListBox x:Name="ResultsList" MouseDoubleClick="ResultsList_DoubleClick" KeyDown="ResultsList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="70">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}"/>
                                    <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MwBrush.TextMuted}" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Snippet}" Foreground="{StaticResource MwBrush.Text}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="38"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="_원본 열기" IsEnabled="{Binding CanOpen}" Tag="{Binding}" Click="OpenMail_Click" Style="{StaticResource MwButton.Secondary}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="검색어를 입력하면 로컬 메일 인덱스에서 찾습니다." Foreground="{StaticResource MwBrush.TextMuted}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
