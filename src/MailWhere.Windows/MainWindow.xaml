<Window x:Class="MailWhere.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MailWhere" Height="720" Width="1120" MinHeight="620" MinWidth="980"
        Icon="Assets/app-icon.ico" Background="{StaticResource MwBrush.Page}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource MwButton.Base}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MwBrush.Text}"/>
        </Style>
        <Style x:Key="BoardFilterButton" TargetType="Button" BasedOn="{StaticResource MwSegmentedButton}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MwCardListBoxItem}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{StaticResource MwBrush.SurfaceMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MwBrush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource MwBrush.PrimarySoft}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource MwBrush.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="18" Background="{StaticResource MwBrush.Surface}" Padding="14,12" Margin="0,0,0,10" BorderBrush="{StaticResource MwBrush.Border}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenReviewCandidatesButton" Click="OpenReviewCandidates_Click" Style="{StaticResource MwButton.Secondary}">검토 후보</Button>
                    <Button x:Name="OpenSettingsButton" Click="OpenSettings_Click" Style="{StaticResource MwButton.Secondary}">설정</Button>
                    <Button x:Name="AddManualHeaderButton" Click="AddManualTaskDialog_Click" Style="{StaticResource MwButton.Secondary}">+ 직접 추가</Button>
                    <Button x:Name="ScanRecentMonthButton" Click="ScanRecentMonth_Click" Style="{StaticResource MwButton.Primary}" MinWidth="120">지금 메일 확인</Button>
                    <Button x:Name="StopScanButton" Click="StopScan_Click" Visibility="Hidden" Style="{StaticResource MwButton.Danger}" MinWidth="96">확인 중지</Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MailWhere" FontSize="21" FontWeight="Bold" Foreground="{StaticResource MwBrush.TextStrong}"/>
                    <TextBlock x:Name="StatusText" Text="트레이에서 대기 중입니다." Margin="0,3,0,0" Foreground="{StaticResource MwBrush.TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ScanProgressBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6,12,2"/>
                    <TextBlock x:Name="ScanProgressText" Text="대기 중입니다." Visibility="Collapsed" Foreground="{StaticResource MwBrush.Primary}" FontWeight="SemiBold" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" x:Name="FilterPanel" CornerRadius="14" Background="{StaticResource MwBrush.PrimarySoft}" Padding="3" Margin="0,0,0,10" BorderBrush="{StaticResource MwBrush.BorderStrong}" BorderThickness="1">
            <UniformGrid Rows="1" Columns="4">
                <Button x:Name="TodayFilterButton" Style="{StaticResource BoardFilterButton}" Click="TodayMainFilter_Click">오늘</Button>
                <Button x:Name="WeekFilterButton" Style="{StaticResource BoardFilterButton}" Click="WeekMainFilter_Click">이번 주</Button>
                <Button x:Name="NoDueFilterButton" Style="{StaticResource BoardFilterButton}" Click="NoDueMainFilter_Click">날짜 없음</Button>
                <Button x:Name="AllFilterButton" Style="{StaticResource BoardFilterButton}" Click="AllMainFilter_Click">전체</Button>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" CornerRadius="18" Background="{StaticResource MwBrush.Surface}" Padding="12" BorderBrush="{StaticResource MwBrush.Border}" BorderThickness="1">
            <Grid>
                <ListBox x:Name="TasksList" FontSize="14" MouseDoubleClick="TaskList_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Meta}" Foreground="{StaticResource MwBrush.TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="14,0,14,0" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="열기" IsEnabled="{Binding CanOpen}" Tag="{Binding}" Click="OpenTaskButton_Click" Style="{StaticResource MwButton.Base}" Padding="10,4" MinHeight="28" Margin="0,0,5,0"/>
                                    <Button Content="나중에" IsEnabled="{Binding HasTask}" Tag="{Binding}" Click="SnoozeTaskButton_Click" Style="{StaticResource MwButton.Ghost}" Padding="10,4" MinHeight="28" Margin="0,0,5,0"/>
                                    <Button Content="보관" IsEnabled="{Binding HasTask}" Tag="{Binding}" Click="ArchiveTaskButton_Click" Style="{StaticResource MwButton.Danger}" Padding="10,4" MinHeight="28" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="TasksEmptyText" Text="표시할 업무가 없습니다." Visibility="Collapsed" Foreground="{StaticResource MwBrush.TextMuted}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
